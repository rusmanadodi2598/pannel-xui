#!/usr/bin/env bash
# commit-msg — memaksa pesan commit mengikuti Conventional Commits.
#
#   <type>[optional scope][!]: <subject>
#
# type: feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert
#
# Merge/squash/fixup dari git default tetap diizinkan.
set -u

MSG_FILE="$1"
MSG="$(head -1 "$MSG_FILE" | sed 's/[[:space:]]*$//')"

# Pesan auto-generated git (merge/revert/squash) — izinkan.
case "$MSG" in
  Merge*|Revert*|fixup!*|squash!*)
    exit 0
    ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?!?: .{1,100}$'
if ! echo "$MSG" | grep -qE "$PATTERN"; then
  echo "❌ [commit-msg] pesan commit tidak mengikuti Conventional Commits."
  echo "   Contoh:"
  echo "     feat(shop): tambah flow topup quick-pick"
  echo "     fix(order): debit setelah client row dibuat"
  echo "     docs: update PRD v1.13"
  echo "     ci: tambah gitleaks action"
  echo "   (git commit --no-verify tidak disarankan)"
  exit 1
fi

exit 0
