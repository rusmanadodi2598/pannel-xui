# =============================================================================
# Bot Auto-Order Telegram — Environment Configuration (PRD §19.2)
# Copy to .env and fill in real values. NEVER commit .env.
# Reference bot: /home/rusmanadodi/kentangtech-xui/client-vpn
# =============================================================================

# === Telegram Bot ===
BOT_TOKEN=123456:ABC-your-telegram-bot-token
BOT_DOMAIN=bot-xui.kentangtechstore.com     # Webhook domain (must be public HTTPS)

# === Webhook (WAJIB, tanpa polling) ===
# REST API convention: /api/v1 (PRD §26). Path Telegram webhook dapat diganti,
# asal sesuai URL yang didaftarkan via setWebhook.
WEBHOOK_PORT=8443
WEBHOOK_PATH=/api/v1/webhooks/telegram
WEBHOOK_SECRET=change-me-32-chars-minimum-secret-token
WEBHOOK_MAX_CONNECTIONS=40                   # 1-100 (PRD §14.1)
WEBHOOK_DROP_PENDING=true                    # drop update lama saat setWebhook
WEBHOOK_WORKERS=8                            # worker pool (PRD §14.2)
WEBHOOK_QUEUE_BUFFER=64                      # bounded queue capacity
# TLS di Nginx (bukan Caddy): sertifikat fullchain.pem + privkey.pem di ./certs
# atau Let's Encrypt — lihat README.md bagian TLS.

# === Database & Redis (service native HOST — bukan container compose) ===
# Staging: PostgreSQL 16 (systemd postgresql@16-main, :5432) + Redis
# (redis-server, :6379). Compose memakai network_mode: host sehingga
# localhost/127.0.0.1 di sini tembus langsung ke service host.
DATABASE_URL=postgres://bot:bot@localhost:5432/bot?sslmode=disable
DB_MAX_OPEN_CONNS=25                      # pool limits eksplisit (AGENTS.md §1.7)
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
REDIS_URL=redis://localhost:6379/3
REDIS_POOL_SIZE=50
REDIS_DIAL_TIMEOUT_SEC=5
ENCRYPTION_KEY=base64-of-32-byte-key       # generate: head -c32 /dev/urandom | base64

# === Admin & Gate Grup ===
ADMIN_IDS=123456789,987654321
REQUIRED_GROUP_ID=-100123456789            # kosong = nonaktif
REQUIRED_GROUP_LINK=https://t.me/kentangtech
NOTIFICATION_GROUP_ID=-100123456789

# === Notifikasi & Rate Limit ===
# FR-09: worker kadaluarsa H-7/H-3/H-1 — sweep tiap EXPIRY_NOTIFY_INTERVAL_MIN.
EXPIRY_NOTIFY_DAYS=7,3,1
EXPIRY_NOTIFY_ENABLED=true
EXPIRY_NOTIFY_INTERVAL_MIN=360        # 6 jam (1-1440 menit); makin pendek, reminder H-1 makin akurat
EXPIRY_NOTIFY_BATCH=50                # maks akun per ambang per sweep
RATE_LIMIT_REQUESTS=30
TIME_LOCATION=Asia/Jakarta

# === Traffic Sync (M6, PRD §16.2) — sinkron traffic panel → vpn_clients ===
TRAFFIC_SYNC_ENABLED=true
TRAFFIC_SYNC_INTERVAL_MIN=5           # 1-60 menit (PRD: 5-10)
TRAFFIC_SYNC_BATCH=200                # maks client per sweep

# === Health Check Panel (v1.45, PRD §17) — server mati tidak dijual ===
# Sweep ping tiap panel aktif (GET /xui/API/server/status); hasil ditulis ke
# health_status (ok/down) dan panel down otomatis hilang dari menu beli.
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SEC=60           # 1-3600 detik (PRD: 60)

# === Trial Cleanup (v1.45, PRD worker) — nonaktifkan akun trial expired ===
# Trial berdurasi 1 jam (FR-07); sweep ini disable akun expired di panel lalu
# tandai is_expired di DB — trial yang lewat masa pakai tidak mencuri kuota.
TRIAL_CLEANUP_ENABLED=true
TRIAL_CLEANUP_INTERVAL_MIN=15          # 1-1440 menit
TRIAL_CLEANUP_BATCH=50                 # maks akun per sweep

# === X-UI Panel API ===
XUI_API_TIMEOUT=30

# === Multi-Panel (M4, FR-10) — isi nilai asli di .env, JANGAN di sini ===
# Setiap blok PANEL_N_* = satu instance X-UI. Urut 1..N; kosongkan HOST untuk berhenti.
#   PANEL_1_NAME=Panel-Staging-ID
#   PANEL_1_HOST=panel.example.com
#   PANEL_1_PORT=443
#   PANEL_1_USERNAME=admin
#   PANEL_1_PASSWORD=super-secret-password
#   PANEL_1_API_PATH=/panel
#   PANEL_1_USE_SSL=true
#   PANEL_1_INSECURE=false          # true HANYA utk panel staging self-signed
#   PANEL_1_COUNTRY_CODE=ID
#   PANEL_1_FLAG_EMOJI=🇮🇩
#   PANEL_1_LOCATION=Jakarta
#   PANEL_1_PROTOCOLS=vless,vmess

# === Pricing Seed (M4) ===
PRICING_SEED_FILE=seed/pricing.json

# === Trial (M6, FR-07) — maks 2 akun/hari, durasi 1 jam, kuota 1 GB ===
TRIAL_ENABLED=true
TRIAL_DAILY_LIMIT=2
TRIAL_DURATION_HOURS=1
TRIAL_TRAFFIC_GB=1
TRIAL_IP_LIMIT=1

# === Payment KentangTech API (QRIS) ===
API_BASE_URL=https://hostinger.kentangtechstore.com
TOPUP_API_KEY=your-topup-api-key
TOPUP_WEBHOOK_SECRET=your-topup-webhook-secret
MIN_TOPUP_AMOUNT=5000
MAX_TOPUP_AMOUNT=5000000
QRIS_FEE_PERCENT=0.025
QRIS_PPN_PERCENT=0.11
QRIS_EXPIRY_MINUTES=15

# === Application ===
LOG_LEVEL=info                              # debug | info | warning | error
